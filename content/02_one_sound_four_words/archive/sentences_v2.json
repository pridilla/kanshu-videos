[
  {
    "key": "open",
    "text": "Okay so.",
    "start": 0.0,
    "end": 0.721
  },
  {
    "key": "open2",
    "text": "Chinese does something that just melts English speakers' brains.",
    "start": 2.616,
    "end": 7.277
  },
  {
    "key": "setup1",
    "text": "Same sound.",
    "start": 7.277,
    "end": 7.837
  },
  {
    "key": "setup2",
    "text": "Four completely different words.",
    "start": 7.997,
    "end": 10.154
  },
  {
    "key": "setup3",
    "text": "The only thing that changes is your pitch.",
    "start": 10.374,
    "end": 13.353
  },
  {
    "key": "setup4",
    "text": "Your voice goes up, down, flat, sharp drop \u2014",
    "start": 13.449,
    "end": 18.152
  },
  {
    "key": "setup5",
    "text": "and suddenly you're saying something else entirely.",
    "start": 18.172,
    "end": 20.506
  },
  {
    "key": "setup6",
    "text": "The example everyone uses.",
    "start": 20.506,
    "end": 20.506
  },
  {
    "key": "setup7",
    "text": "The sound is ma.",
    "start": 20.506,
    "end": 25.212
  },
  {
    "key": "t1",
    "text": "First tone.",
    "start": 25.212,
    "end": 26.057
  },
  {
    "key": "t1d1",
    "text": "Keep it high and flat.",
    "start": 26.201,
    "end": 27.738
  },
  {
    "key": "t1d2",
    "text": "Like you're singing.",
    "start": 27.802,
    "end": 29.219
  },
  {
    "key": "t1pinyin",
    "text": ".m\u0101.",
    "start": 29.519,
    "end": 30.979
  },
  {
    "key": "t1word",
    "text": "Mother.",
    "start": 31.076,
    "end": 31.738
  },
  {
    "key": "t2",
    "text": "Second tone.",
    "start": 31.738,
    "end": 33.499
  },
  {
    "key": "t2d1",
    "text": "Start low, rise up.",
    "start": 33.606,
    "end": 35.261
  },
  {
    "key": "t2d2",
    "text": "Like you're surprised.",
    "start": 35.341,
    "end": 36.542
  },
  {
    "key": "t2pinyin",
    "text": ".m\u00e1.",
    "start": 37.062,
    "end": 38.222
  },
  {
    "key": "t2word",
    "text": "Hemp.",
    "start": 39.312,
    "end": 40.724
  },
  {
    "key": "t3",
    "text": "Third tone.",
    "start": 40.724,
    "end": 41.904
  },
  {
    "key": "t3d1",
    "text": "Dip down, come back up.",
    "start": 42.084,
    "end": 44.064
  },
  {
    "key": "t3d2",
    "text": "Like you're really thinking about it.",
    "start": 44.128,
    "end": 45.989
  },
  {
    "key": "t3pinyin",
    "text": ".m\u01ce.",
    "start": 46.549,
    "end": 48.349
  },
  {
    "key": "t3word",
    "text": "Horse.",
    "start": 48.476,
    "end": 49.271
  },
  {
    "key": "t4",
    "text": "Fourth tone.",
    "start": 49.271,
    "end": 50.069
  },
  {
    "key": "t4d1",
    "text": "Drop it hard.",
    "start": 50.229,
    "end": 51.43
  },
  {
    "key": "t4d2",
    "text": "Like you're telling someone to stop.",
    "start": 51.51,
    "end": 53.508
  },
  {
    "key": "t4pinyin",
    "text": ".m\u00e0.",
    "start": 53.748000000000005,
    "end": 54.708
  },
  {
    "key": "t4word",
    "text": "Scold.",
    "start": 54.761,
    "end": 56.228
  },
  {
    "key": "sum1",
    "text": "Same sound.",
    "start": 56.228,
    "end": 56.71
  },
  {
    "key": "sum2",
    "text": "Four words.",
    "start": 56.79,
    "end": 57.67
  },
  {
    "key": "sum3",
    "text": "Wrong pitch, wrong word.",
    "start": 60.02,
    "end": 61.67
  },
  {
    "key": "sum4",
    "text": "That's the whole thing.",
    "start": 61.718,
    "end": 62.979
  },
  {
    "key": "wall1",
    "text": "Every learner gets caught by this.",
    "start": 62.979,
    "end": 64.874
  },
  {
    "key": "wall2",
    "text": "You can know the character cold and still mess it up.",
    "start": 65.014,
    "end": 67.753
  },
  {
    "key": "wall3",
    "text": "Just because your voice went up instead of down.",
    "start": 67.81700000000001,
    "end": 70.473
  },
  {
    "key": "cta1",
    "text": "That's how Chinese tones work.",
    "start": 70.473,
    "end": 72.791
  },
  {
    "key": "cta2",
    "text": "Follow kanshu.app to learn more about the language.",
    "start": 72.86,
    "end": 76.071
  }
]